/************************************************************************/

/* ID⇔文字列情報 */
struct str_info
{
	int			id;								/* ID */
	LPCWSTR		str;							/* 文字列 */
};

/* ID⇔名前情報 */
struct name_info
{
	int			id;								/* ID */
	LPCTSTR		name;							/* 名前 */
};

/* モンスター特性情報 */
struct ability_info
{
	int			ability;						/* 特性ID */
	LPCTSTR		name;							/* 特性名 */
	int			upper;							/* 下位特性ID */
	int			lower;							/* 下位特性ID */
};

/* モンスタースキル情報 */
struct skillset_info
{
	int			skillset;						/* スキルID */
	LPCTSTR		name;							/* スキル名 */
	BOOL		param;							/* パラメータスキルフラグ */
	int			point[10];						/* 特技開放所要スキルポイント */
	int			type[10];						/* 開放特技タイプ */
	int			value[10];						/* 開放特技の値 */
};

/* モンスター特技情報 */
struct skill_info
{
	int			skill;							/* 特技ID */
	LPCTSTR		name;							/* 特技名 */
	int			upper[3];						/* 上位特技ID */
	int			lower[3];						/* 下位特技ID */
};

/* 道具情報 */
struct item_info
{
	int			item;							/* 道具ID */
	int			type;							/* 道具タイプ */
	LPCTSTR		name;							/* 道具名 */
	int			add_atk;						/* 装備時増加する攻撃力 */
	int			add_def;						/* 装備時増加する防御力 */
	int			add_agi;						/* 装備時増加する素早さ */
	int			add_int;						/* 装備時増加する賢さ */
};

/* モンスター種族情報 */
struct race_info
{
	int			race;							/* 種族ID */
	int			rank;							/* 既定ランク */
	int			type;							/* 既定系統 */
	LPCTSTR		name;							/* モンスター名 */
	UINT8		equip_mask;						/* 装備可能武器タイプマスク */
	UINT16		limit_hp;						/* HP成長限界 */
	UINT16		limit_mp;						/* MP成長限界 */
	UINT16		limit_atk;						/* 攻撃力成長限界 */
	UINT16		limit_def;						/* 守備力成長限界 */
	UINT16		limit_agi;						/* 素早さ成長限界 */
	UINT16		limit_int;						/* 賢さ成長限界 */
	UINT8		base_guard[16];					/* 既定ガード */
	UINT8		base_ability[8];				/* 既定特性 */
	UINT8		base_skillset[4];				/* 既定スキル */
	UINT8		rom_data1[4];					/* 不明、ROMデータその１ */
	UINT8		rom_data2[24];					/* 不明、ROMデータその２ */
};

